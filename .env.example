# LLM provider — set the model and corresponding API key
# Default: Anthropic. Swap both values to switch providers.
# Examples:
#   anthropic/claude-sonnet-4-5  → ANTHROPIC_API_KEY
#   openai/gpt-4o                → OPENAI_API_KEY
#   nvidia/meta/llama-3.1-70b-instruct → NVIDIA_API_KEY
MODEL=anthropic/claude-sonnet-4-5

ANTHROPIC_API_KEY=    # required if MODEL starts with anthropic/
OPENAI_API_KEY=       # required if MODEL starts with openai/
NVIDIA_API_KEY=       # required if MODEL starts with nvidia/
GOOGLE_API_KEY=       # required if MODEL starts with google/

# Required — scrapes App Store listing pages
FIRECRAWL_API_KEY=